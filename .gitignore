.env

# Logs
*.log
logs/*
!logs/.gitkeep

# Temp and machine-local importer state
*.lock
*.tmp
*.temp
output/*
!output/.gitkeep

# Runtime folders (Excel moves here; keep folder placeholders)
processed/*
!processed/.gitkeep
failed/*
!failed/.gitkeep
inbox/**/*
!inbox/.gitkeep
!inbox/AGRA/
!inbox/NOIDA/
!inbox/HYD/
!inbox/AGRA/.gitkeep
!inbox/NOIDA/.gitkeep
!inbox/HYD/.gitkeep

# Python bytecode
__pycache__/
*.py[cod]

# Dependencies and backups
backups/

# Excel attendance files (machine-local)
*.xls
*.xlsx
*.xlsm
*.bak