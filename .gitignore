.env

# Runtime folders created by Setup.bat (not in the clone)
logs/
output/
processed/
failed/

# Temp and machine-local importer state
*.lock
*.tmp
*.temp
*.log

# Python bytecode
__pycache__/
*.py[cod]

# Dependencies and backups
backups/

# Excel attendance files (machine-local)
*.xls
*.xlsx
*.xlsm
*.bak
