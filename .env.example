# Copy to .env on the server (sidecar) or office PC (importer). Never commit the real file.

# --- Office importer ---
LOCATION_CODE=NOIDA
DDO_API_ENDPOINT=https://ddoplusnodeapi.walkingtree.tech/api/attendance/import
DDO_API_TOKEN=
DDO_API_TIMEOUT_SECONDS=30
DDO_API_MAX_RETRIES=3
ATTENDANCE_DIR=D:\Attendance
INBOX_DIR=
INBOX_STABLE_SECONDS=15
DDO_ALERT_WEBHOOK_URL=

# --- Sidecar API (same host/network as NocoBase Postgres) ---
NODE_ENV=production
DDO_API_PORT=3000
DDO_API_BIND=127.0.0.1
DDO_API_ALLOW_IPS=
DDO_TRUST_PROXY=1

# Same PostgreSQL as NocoBase 0.9.4-alpha.2
DATABASE_URL=postgres://ddo_att_importer:CHANGE_ME@127.0.0.1:5432/nocobase
# Or discrete NocoBase-style names:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nocobase
# DB_USER=ddo_att_importer
# DB_PASSWORD=
# PGSSLMODE=require

# Optional sidecar TLS if Nginx is not terminating HTTPS
# DDO_TLS_CERT=
# DDO_TLS_KEY=
